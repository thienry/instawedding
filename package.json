{
  "name": "instawedding",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --reporter=dot",
    "lint": "oxlint -f unix",
