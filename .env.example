# Switch between mock implementations and cloud services (Supabase/R2)
VITE_USE_MOCKS=true

# Mock Mode Configuration (Optional)
VITE_MOCK_ADMIN_PIN=2026

# Supabase Public Configuration (Client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Admin Configuration (Serverless backend only - NEVER EXPOSE TO CLIENT)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Security & Authentication (Serverless backend only)
ADMIN_PIN=2026
ADMIN_JWT_SECRET=generate-a-strong-random-hex-string-for-production

# Cloudflare R2 Storage Configuration (Serverless backend only)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=instawedding-bucket
R2_PUBLIC_DOMAIN=https://pub-xxx.r2.dev
